# required env vars-ის დოკუმენტაცია. რეალური secret-ები არასდროს commit-დება.
# გამოყენება: დააკოპირე services/collector/.env-ში და შეავსე API_KEY.
#   cp .env.example services/collector/.env

# --- TTC / AzRy API (აუცილებელი) ---
# transit.ttc.com.ge-ის X-Api-Key. collector-იც და api-ც იყენებს.
API_KEY=

# --- collector (არასავალდებულო — ნაგულისხმევები config.py-შია) ---
# POLL_INTERVAL_SECONDS=30
# POSITIONS_POLL_INTERVAL_SECONDS=60
# POSITIONS_BOTH_DIRECTIONS=true
# TARGET_STOP_COUNT=30
# DATA_DIR=/data                  # container-ში raw_data volume

# --- Kafka (არასავალდებულო, opt-in) ---
# ცარიელი/არ-დაყენებული = collector მხოლოდ JSONL-ში წერს (atlas-ის production-ი ასე მუშაობს).
# compose-ი ამას თავად აყენებს kafka:9092-ზე. ჰოსტიდან: localhost:29092.
# KAFKA_BOOTSTRAP=
# KAFKA_TOPIC_ARRIVALS=ttc.arrivals
# KAFKA_TOPIC_POSITIONS=ttc.positions
# KAFKA_GROUP=ttc-ingest          # consumer-ის group (services/ingest)

# --- postgres (მონაცემთა ნაკადის საცავი) ---
# POSTGRES_USER=ttc
# POSTGRES_PASSWORD=ttc
# POSTGRES_DB=ttc

# --- processing/ETL-ის კავშირი Postgres-თან (services/processing) ---
# ჰოსტიდან: localhost; container-იდან: postgres (compose-ის სერვისის სახელი).
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# ან ერთი სტრიქონით (override-ს უკეთებს ზემოთებს):
# DATABASE_URL=postgresql://ttc:ttc@localhost:5432/ttc
