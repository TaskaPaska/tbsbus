# required env vars-ის დოკუმენტაცია. რეალური secret-ები არასდროს commit-დება.
# გამოყენება: დააკოპირე services/collector/.env-ში და შეავსე API_KEY.
#   cp .env.example services/collector/.env

# --- TTC / AzRy API (აუცილებელი) ---
# transit.ttc.com.ge-ის X-Api-Key. collector-იც და api-ც იყენებს.
API_KEY=

# --- collector (არასავალდებულო — ნაგულისხმევები config.py-შია) ---
# POLL_INTERVAL_SECONDS=30
# POSITIONS_POLL_INTERVAL_SECONDS=60
# POSITIONS_BOTH_DIRECTIONS=true
# TARGET_STOP_COUNT=30
# DATA_DIR=/data                  # container-ში raw_data volume

# --- postgres (მხოლოდ `--profile db`-სთვის) ---
# POSTGRES_USER=ttc
# POSTGRES_PASSWORD=ttc
# POSTGRES_DB=ttc
