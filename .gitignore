# Secrets / environment
.env
.env.*
!.env.example

# Cloudflare Tunnel — never commit credentials/cert (these live on atlas: /etc/cloudflared, ~/.cloudflared).
# Narrow, explicit patterns only — do NOT blanket-ignore *.json (would mask tracked configs).
cert.pem
*.pem
.cloudflared/
**/cloudflared/*.json     # tunnel credentials file is <TUNNEL-UUID>.json
*tunnel*credentials*.json

# Collected data (raw snapshots — can be large; never committed)
data/raw/
*.jsonl

# Generated/processed data and model artifacts (re-creatable from raw via the pipeline)
data/processed/
*.joblib
*.pkl

# Selected stop set is machine-generated; keep it local unless deliberately shared
services/collector/tracked_stops.json

# Python
.venv/
venv/
bin/
lib/
pyvenv.cfg
__pycache__/
*.pyc

# Private Claude Code context (local only)
CLAUDE.local.md
.claude/
docs/ai-usage-log.md
docs/decisions.md
NEXT_APP_PLAN.md

# IDE / OS
.idea/
.DS_Store
Thumbs.db

# Claude Design reference mockup (not source)
Mova Bus App (standalone).html

# Private manager comments — NEVER commit (per instruction)
additional.txt

# Course materials & Word deliverables — kept out of the code repo (sent by email).
# The technical documentation is delivered by email; to include it in the repo,
# run: git add -f ტექნიკური_დოკუმენტაცია.docx
*.docx
